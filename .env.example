# AI Radar settings. Export these in the shell; the service does not load this file itself.
# Every variable is optional. Values shown are the defaults.

# Where the single data file lives (SQLite file).
DATABASE_URL=sqlite:///data/radar.db

# Address the service listens on.
HOST=127.0.0.1

# Port the service listens on (1-65535).
PORT=8000

# Time of day for the daily scan, 24-hour HH:MM.
SCAN_TIME=06:00

# Time zone (IANA name) used for SCAN_TIME.
SCAN_TIMEZONE=Asia/Kolkata

# Name of the model used for ranking and summaries (unset until the LLM story needs it).
LLM_MODEL=

# Optional GitHub token for higher rate limits. The only secret; leave empty here.
GITHUB_TOKEN=
